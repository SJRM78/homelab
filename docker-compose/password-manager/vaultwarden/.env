#DATABASE_URL=postgresql://root:password@postgresdb:5432/vaultwarden
DB_CONNECTION_RETRIES=10
DATABASE_TIMEOUT=30
ENABLE_WEBSOCKET=true
PUSH_ENABLED=true

## Enables push notifications (requires key and id from https://bitwarden.com/host)
#PUSH_INSTALLATION_ID=CHANGEME
#PUSH_INSTALLATION_KEY=CHANGEME

DOMAIN="https://vaultwarden.example.com"
SENDS_ALLOWED=true
## HaveIBeenPwned API Key, request it here: https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=

TRASH_AUTO_DELETE_DAYS=30
SIGNUPS_ALLOWED=true
# SIGNUPS_VERIFY=false
EMERGENCY_ACCESS_ALLOWED=true
EMAIL_CHANGE_ALLOWED=false

# LOG_FILE=/path/to/log
# LOG_LEVEL=info # trace, debug, info, warn, error, off

# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$MmeKRnGK5RW5mJS7h3TOL89GrpLPXJPAtTK8FTqj9HM$DqsstvoSAETl9YhnsXbf43WeaUwJC6JhViIvuPoig78'

EMAIL_2FA_AUTO_FALLBACK=true
AUTHENTICATOR_DISABLE_TIME_DRIFT=true

SMTP_HOST=smtp.gmail.com
SMTP_FROM=vaultwarden@domain.tld
SMTP_FROM_NAME=Vaultwarden
SMTP_USERNAME=username@gmail.com
SMTP_PASSWORD=password
SMTP_TIMEOUT=15
SMTP_SECURITY=force_tls
SMTP_PORT=465

## Server name sent during the SMTP HELO
# HELO_NAME=

# SMTP_ACCEPT_INVALID_CERTS=false
# SMTP_ACCEPT_INVALID_HOSTNAMES=false
